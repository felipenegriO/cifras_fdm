# ── Banco de Dados ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASS=sua_senha
E2E_DB_NAME=seu_banco_e2e
DB_NAME=seu_banco

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=development
TEST_EMAIL=admin-e2e@exemplo.local
TEST_PASSWORD=defina_uma_senha_forte_local
LEGAL_TERMS_VERSION=2026-08-03
LEGAL_PRIVACY_VERSION=2026-08-03
TERMS_URL=/termos.php
PRIVACY_URL=/privacidade.php
BACKUP_TARGET_DIR=C:/backups-externos/cifro
BACKUP_ENCRYPTION_KEY=base64_de_32_bytes
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
ALERT_WEBHOOK_URL=
APP_DEBUG=false
APP_URL=https://seudominio.com
ENCRYPTION_KEY=chave_aleatoria_de_32_caracteres_aqui
BETA_CLOSED_ENABLED=false
BETA_INVITED_BAND_IDS=

# ── E-mail (Hostinger SMTP) ───────────────────────────────────────────────────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_TIMEOUT_SECONDS=10
MAIL_USER=noreply@seudominio.com
MAIL_PASS=sua_senha_email
MAIL_FROM_NAME=Cifrô

# Configuracao de Seguranca
CSRF_TOKEN_LIFETIME=300

# ── Login com Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seudominio.com/api/auth/google/callback

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs dos produtos no Stripe Dashboard
STRIPE_PRICE_MENSAL=price_...
STRIPE_PRICE_SEMESTRAL=price_...
STRIPE_PRICE_ANUAL=price_...

# Payment Links gerados no Stripe Dashboard (aparece na página /plano.php)
STRIPE_LINK_MENSAL=https://buy.stripe.com/...
STRIPE_LINK_SEMESTRAL=https://buy.stripe.com/...
STRIPE_LINK_ANUAL=https://buy.stripe.com/...

# ── Pagamento manual via PIX ──────────────────────────────────────────────────
PAYMENT_PIX_PHONE=
PAYMENT_WHATSAPP_PHONE=
PAYMENT_PIX_RECIPIENT=
