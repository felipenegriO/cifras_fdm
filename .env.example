# ── Banco de Dados ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASS=sua_senha
E2E_DB_NAME=seu_banco_e2e
DB_NAME=seu_banco

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=development
TEST_EMAIL=admin-e2e@exemplo.local
TEST_PASSWORD=defina_uma_senha_forte_local
LEGAL_TERMS_VERSION=2026-08-03
LEGAL_PRIVACY_VERSION=2026-08-03
TERMS_URL=/termos.php
PRIVACY_URL=/privacidade.php
BACKUP_TARGET_DIR=C:/backups-externos/cifro
BACKUP_ENCRYPTION_KEY=base64_de_32_bytes
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
ALERT_WEBHOOK_URL=
APP_DEBUG=false
APP_URL=https://seudominio.com
ENCRYPTION_KEY=chave_aleatoria_de_32_caracteres_aqui
BETA_CLOSED_ENABLED=false
BETA_INVITED_BAND_IDS=

# ── Landing page e documentos legais ──────────────────────────────────────────
# Identificação do responsável (MVP sem CNPJ). Sem OWNER_NAME, a landing e os
# documentos legais dizem apenas "pessoa física" — nunca inventam razão social.
OWNER_NAME=
OWNER_LOCATION=
SUPPORT_EMAIL=contato@cifro.online
# Prova social: só aparece na landing se AMBOS estiverem preenchidos com algo real.
SOCIAL_PROOF_QUOTE=
SOCIAL_PROOF_AUTHOR=

# Google Analytics 4 (gratuito). Crie a propriedade em analytics.google.com,
# copie o "ID de mensuração" (formato G-XXXXXXXXXX) e cole aqui.
# Sem valor, a landing não carrega nenhum script de analytics.
GA4_MEASUREMENT_ID=

# ── E-mail (Hostinger SMTP) ───────────────────────────────────────────────────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_TIMEOUT_SECONDS=10
MAIL_USER=noreply@seudominio.com
MAIL_PASS=sua_senha_email
MAIL_FROM_NAME=Cifrô
# Endereço de destino para testes de integração SMTP (npm run test:integration).
# Defina um e-mail real no .env.local para receber os envios de teste.
MAIL_INTEGRATION_TEST_TO=
E2E_IMAP_MAILBOX=
E2E_IMAP_USER=
E2E_IMAP_PASSWORD=
E2E_YOUTUBE_VIDEO_ID=
E2E_GOOGLE_STORAGE_STATE=
E2E_GOOGLE_ID_TOKEN=
E2E_GOOGLE_EMAIL=
E2E_EXTERNAL_REAL=false
E2E_STRIPE_CHECKOUT_COMPLETE=false

# Configuracao de Seguranca
CSRF_TOKEN_LIFETIME=300

# ── Login com Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seudominio.com/api/auth/google/callback

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs dos produtos no Stripe Dashboard (obrigatório para Checkout Sessions)
# Criar em: Stripe Dashboard → Products → Price → copiar o ID "price_..."
STRIPE_PRICE_MENSAL=price_...
STRIPE_PRICE_SEMESTRAL=price_...
STRIPE_PRICE_ANUAL=price_...

# ── Pagamento manual via PIX ──────────────────────────────────────────────────
PAYMENT_PIX_PHONE=
PAYMENT_WHATSAPP_PHONE=
PAYMENT_PIX_RECIPIENT=
