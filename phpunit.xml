<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/php/bootstrap.php"
         colors="true"
         cacheResultFile=".phpunit.cache/test-results"
         executionOrder="depends,defects"
         beStrictAboutOutputDuringTests="true"
         failOnWarning="true">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="OPENSSL_CONF" value="C:\xampp\apache\conf\openssl.cnf" force="true"/>
    </php>
    <!-- Os testes marcados com @group integration abrem conexões SMTP REAIS
         contra o servidor de produção. Rodá-los na suíte padrão fazia cada
         execução autenticar 8 vezes em smtp.hostinger.com — repetido dezenas
         de vezes num dia de trabalho, isso é indistinguível de abuso e leva a
         conta de e-mail à suspensão. Rode-os sob demanda: npm run test:integration -->
    <groups>
        <exclude>
            <group>integration</group>
        </exclude>
    </groups>

    <testsuites>
        <testsuite name="unit">
            <directory>tests/php</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">public/src/Services</directory>
            <directory suffix=".php">public/src/Repositories</directory>
        </include>
    </coverage>
</phpunit>
