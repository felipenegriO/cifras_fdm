<IfModule mod_expires.c>
  ExpiresActive On

  # Cache por 1 ano para arquivos com versão ou hash no nome
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|woff2?|ttf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
