{
    "name": "cifro/cifras",
    "description": "Cifrô: app de cifras, roteiros e modo ao vivo para bandas.",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/php/"
        },
        "classmap": [
            "public/src/Services/",
            "public/src/Repositories/",
            "public/src/Controllers/"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
